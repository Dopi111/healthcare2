# ============================================
# Đây là file excample
# ============================================

# Server Configuration
PORT=5001
NODE_ENV=development

# PostgreSQL Database Configuration
PG_USER=postgres
PG_HOST=localhost
PG_DATABASE=healthcare_db 
PG_PASSWORD=your_postgres_password # Đổi thành password của bạn khi cài postgres
PG_PORT=5432 # Mặc định là 5432, đổi nếu bạn dùng port khác PORT có thể xem trong properties của postgres connection   

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Admin Default Password (for initial setup)
ADMIN_PASSWORD=Admin@123

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# ============================================
# INSTRUCTIONS:
# 1. Đổi file này thành .env, nhớ là phải có đường dẫn là /backend/.env
# 2. Cập nhật các giá trị phù hợp với môi trường của bạn
# 3. KHÔNG COMMIT file .env vào hệ thống quản lý mã nguồn!
# ============================================
